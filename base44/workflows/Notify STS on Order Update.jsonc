{
  "name": "Notify STS on Order Update",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.company == \"STS Service Desk\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "SalesOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_sts_on_order_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySTSOrderUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}