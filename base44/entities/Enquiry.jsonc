{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "enquiry_number": {
      "type": "string",
      "description": "Auto-generated enquiry reference"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "part_description": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "urgency": {
      "type": "string",
      "enum": [
        "standard",
        "urgent",
        "breakdown"
      ],
      "default": "standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "quoted",
        "converted",
        "closed"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "email",
        "walk_in"
      ],
      "default": "website"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "customer_name",
    "part_description"
  ]
}