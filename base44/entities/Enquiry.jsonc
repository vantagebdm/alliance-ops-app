{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "enquiry_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "part_description": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "oem_number": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "rego": {
      "type": "string"
    },
    "fleet_number": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "urgency": {
      "type": "string",
      "enum": [
        "standard",
        "urgent",
        "breakdown"
      ],
      "default": "standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "unread",
        "under_review",
        "waiting_on_customer",
        "pricing_in_progress",
        "sourcing_in_progress",
        "quoted",
        "converted",
        "closed"
      ],
      "default": "new"
    },
    "assigned_to": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "quote_number": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "website",
        "phone",
        "email",
        "walk_in",
        "trade_account"
      ],
      "default": "website"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "mimetype": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        }
      }
    },
    "email_thread_id": {
      "type": "string"
    },
    "email_message_id": {
      "type": "string"
    },
    "email_subject": {
      "type": "string"
    },
    "email_body": {
      "type": "string"
    },
    "email_sender_name": {
      "type": "string"
    },
    "email_sender_address": {
      "type": "string"
    },
    "is_unread": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "customer_name",
    "part_description"
  ]
}