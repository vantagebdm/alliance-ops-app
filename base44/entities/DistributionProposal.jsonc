{
  "name": "DistributionProposal",
  "type": "object",
  "properties": {
    "proposal_number": {
      "type": "string",
      "description": "Auto-generated proposal reference e.g. DP-0001"
    },
    "supplier": {
      "type": "string",
      "enum": [
        "total_energies",
        "wurth",
        "gates_products",
        "powercrank"
      ]
    },
    "title": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_company": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "current_customer": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "default": "no",
      "description": "Is the client an existing customer?"
    },
    "client_number": {
      "type": "string",
      "description": "Existing client/account number if current customer"
    },
    "trade_company": {
      "type": "string",
      "description": "Trading company name (Tab 2 contact details)"
    },
    "best_contact": {
      "type": "string",
      "description": "Best contact person for the proposal"
    },
    "best_contact_phone": {
      "type": "string"
    },
    "best_contact_email": {
      "type": "string"
    },
    "proposal_type": {
      "type": "string",
      "enum": [
        "retail",
        "trade_business",
        "commercial"
      ]
    },
    "trading_terms": {
      "type": "string",
      "enum": [
        "cod",
        "14_days",
        "30_days",
        "30_days_plus"
      ]
    },
    "deposit_required": {
      "type": "boolean",
      "default": false
    },
    "deposit_pct": {
      "type": "number",
      "default": 0
    },
    "balance_terms": {
      "type": "string",
      "description": "Terms for the balance payment"
    },
    "validity_days": {
      "type": "number",
      "default": 30
    },
    "conditions_text": {
      "type": "string",
      "description": "Free-text terms & conditions"
    },
    "standard_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "retail",
          "trade",
          "commercial"
        ]
      },
      "description": "Selected standard term sets applied to this proposal"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier_sku": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "pack_size": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "gst": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "rejected"
      ],
      "default": "draft"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier",
    "customer_name"
  ]
}