{
  "name": "Dispatch",
  "type": "object",
  "properties": {
    "dispatch_number": {
      "type": "string"
    },
    "dispatch_source": {
      "type": "string",
      "enum": [
        "sales_order",
        "customer_order",
        "manual",
        "urgent_breakdown"
      ],
      "default": "manual"
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_po_number": {
      "type": "string"
    },
    "job_number": {
      "type": "string"
    },
    "site_contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "pickup",
        "local_delivery",
        "freight",
        "remote_site",
        "internal_transfer"
      ],
      "default": "pickup"
    },
    "priority": {
      "type": "string",
      "enum": [
        "standard",
        "same_day",
        "urgent",
        "breakdown_critical"
      ],
      "default": "standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_to_pick",
        "picked",
        "packed",
        "dispatched",
        "in_transit",
        "delivered",
        "collected",
        "partial",
        "cancelled"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ordered_qty": {
            "type": "number"
          },
          "available_qty": {
            "type": "number"
          },
          "dispatch_qty": {
            "type": "number"
          },
          "remaining_qty": {
            "type": "number"
          },
          "location": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "pickup_contact": {
      "type": "string"
    },
    "pickup_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_notes": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "delivery_suburb": {
      "type": "string"
    },
    "delivery_contact": {
      "type": "string"
    },
    "delivery_instructions": {
      "type": "string"
    },
    "requested_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "freight_company": {
      "type": "string"
    },
    "consignment_number": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "site_access_instructions": {
      "type": "string"
    },
    "from_location": {
      "type": "string"
    },
    "to_location": {
      "type": "string"
    },
    "transfer_reference": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "eta": {
      "type": "string",
      "format": "date"
    },
    "warehouse_location": {
      "type": "string"
    },
    "assigned_staff": {
      "type": "string"
    },
    "picked_by": {
      "type": "string"
    },
    "packed_by": {
      "type": "string"
    },
    "dispatch_date": {
      "type": "string",
      "format": "date"
    },
    "internal_notes": {
      "type": "string"
    },
    "customer_notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "customer_name",
    "dispatch_number"
  ]
}