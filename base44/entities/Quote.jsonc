{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string"
    },
    "enquiry_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string",
      "description": "Contact phone number for quote requests"
    },
    "company": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "rejected",
        "expired",
        "quote_request"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "eta_days": {
            "type": "number",
            "description": "Estimated time of arrival in days"
          },
          "eta_comment": {
            "type": "string",
            "description": "ETA comment e.g. 'ex east', 'ex west'"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "gst": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Name of person who submitted the quote request via portal"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "normal",
        "urgent",
        "breakdown"
      ],
      "default": "normal"
    },
    "job_number": {
      "type": "string",
      "description": "Job/work order number"
    },
    "po_inv_number": {
      "type": "string",
      "description": "PO or Invoice reference number"
    },
    "asset_type": {
      "type": "string",
      "description": "Type of asset"
    },
    "asset_fleet_number": {
      "type": "string",
      "description": "Asset or fleet number"
    },
    "asset_make": {
      "type": "string",
      "description": "Asset manufacturer/make"
    },
    "asset_model": {
      "type": "string",
      "description": "Asset model"
    },
    "rego": {
      "type": "string",
      "description": "Vehicle registration"
    },
    "vin_serial": {
      "type": "string",
      "description": "VIN or serial number"
    },
    "client_owner": {
      "type": "string",
      "description": "Client or owner of the asset"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reference images uploaded with the quote request"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Parts accuracy acknowledgement"
    },
    "request_source": {
      "type": "string",
      "description": "Source of the quote request e.g. portal, internal"
    }
  },
  "required": [
    "customer_name"
  ]
}