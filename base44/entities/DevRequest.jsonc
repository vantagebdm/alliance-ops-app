{
  "name": "DevRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string",
      "description": "Auto-generated request number e.g. DEV-0001"
    },
    "requested_by": {
      "type": "string",
      "description": "Name of the user who submitted the request"
    },
    "requested_by_id": {
      "type": "string"
    },
    "request_date": {
      "type": "string",
      "format": "date-time",
      "description": "Auto date & time stamp on creation"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "bug_site_issue",
        "new_idea",
        "function_addition",
        "documentation",
        "process_modification",
        "process_addition"
      ],
      "default": "bug_site_issue"
    },
    "summary": {
      "type": "string",
      "description": "Short title / summary of the request"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "area": {
      "type": "string",
      "enum": [
        "purchasing",
        "invoicing",
        "searching",
        "viewing",
        "saving",
        "general"
      ],
      "default": "general"
    },
    "is_issue": {
      "type": "boolean",
      "default": false,
      "description": "Is this an issue/bug?"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file_type": {
            "type": "string",
            "description": "image or document"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "awaiting_response",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "author_id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "comment",
              "question",
              "answer"
            ],
            "default": "comment"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "requested_by",
    "request_type",
    "summary"
  ]
}