      "type": "string"
    },
    "accounts_email": {
      "type": "string"
    },
    "statement_email": {
      "type": "string"
    },
    "orders_email": {
      "type": "string"
    },
    "returns_email": {
      "type": "string"
    },
    "invoice_email": {
      "type": "string"
    },
