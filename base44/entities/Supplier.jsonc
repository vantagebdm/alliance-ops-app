      "type": "string"
    },
    "address2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "default": "Australia"
    },
    "warehouse_same_as_head": {
      "type": "boolean",
      "default": true
    },
    "warehouse_address": {
      "type": "string"
    },
    "warehouse_address2": {
      "type": "string"
    },
    "warehouse_city": {
      "type": "string"
    },
    "warehouse_state": {
      "type": "string"
    },
    "warehouse_postcode": {
      "type": "string"
    },
    "warehouse_country": {
      "type": "string"
    },
