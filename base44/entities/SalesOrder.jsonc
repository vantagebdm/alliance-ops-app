{
  "name": "SalesOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "customer_po_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "processing",
        "ready",
        "dispatched",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "gst": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "delivery_address": {
      "type": "string"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "pickup",
        "local_delivery",
        "freight"
      ],
      "default": "pickup"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "urgent",
        "breakdown"
      ],
      "default": "normal"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Name of person who submitted via portal"
    },
    "job_number": {
      "type": "string",
      "description": "Job/work order number"
    },
    "asset_type": {
      "type": "string",
      "description": "Type of asset (e.g. Heavy Truck, Earthmoving)"
    },
    "asset_fleet_number": {
      "type": "string",
      "description": "Asset or fleet number"
    },
    "asset_make": {
      "type": "string",
      "description": "Asset manufacturer/make"
    },
    "asset_model": {
      "type": "string",
      "description": "Asset model"
    },
    "client_owner": {
      "type": "string",
      "description": "Client or owner of the asset"
    },
    "order_source": {
      "type": "string",
      "description": "Source of the order e.g. sts_portal, internal"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reference images uploaded with the order"
    },
    "acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Parts accuracy acknowledgement"
    }
  },
  "required": [
    "customer_name",
    "order_number"
  ]
}