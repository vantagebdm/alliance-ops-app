{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "confirmed",
        "partial",
        "received",
        "cancelled"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "company_note": {
            "type": "string",
            "description": "Company name the part is being purchased for"
          },
          "line_reference": {
            "type": "string",
            "description": "PO, invoice number, or client ID for receipting context"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "gst": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "expected_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_name",
    "po_number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "purchasing_officer"
          }
        },
        {
          "user_condition": {
            "role": "inventory_controller"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "purchasing_officer"
          }
        },
        {
          "user_condition": {
            "role": "inventory_controller"
          }
        },
        {
          "user_condition": {
            "role": "accounts_payable"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "purchasing_officer"
          }
        },
        {
          "user_condition": {
            "role": "inventory_controller"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}