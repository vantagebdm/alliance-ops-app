{
  "name": "Part",
  "type": "object",
  "properties": {
    "app_part_number": {
      "type": "string",
      "description": "Internal APP generated part number (e.g. APP-ENG0001)"
    },
    "part_number": {
      "type": "string"
    },
    "supplier_sku": {
      "type": "string"
    },
    "oem_number": {
      "type": "string"
    },
    "aftermarket_number": {
      "type": "string"
    },
    "cross_references": {
      "type": "string"
    },
    "superseded_by": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "equipment_type": {
      "type": "string",
      "enum": [
        "light_vehicles",
        "light_trucks",
        "heavy_trucks",
        "trailers",
        "earthmoving",
        "plant_equipment",
        "fixed_plant",
        "generators",
        "agricultural",
        "marine",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "engine",
        "transmission",
        "brakes",
        "suspension",
        "steering",
        "electrical",
        "body",
        "filters",
        "hydraulic",
        "driveline",
        "cooling",
        "fuel",
        "tyres",
        "oils",
        "sprays",
        "consumables",
        "compliance",
        "chemicals",
        "get",
        "seals",
        "fasteners",
        "air_system",
        "final_drive",
        "other"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "fitments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "equipment_type": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "manufacturer_custom": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "series_variant": {
            "type": "string"
          },
          "fitment_type": {
            "type": "string"
          },
          "year_from": {
            "type": "string"
          },
          "year_to": {
            "type": "string"
          },
          "specific_years": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "engine_spec": {
            "type": "string"
          },
          "serial_from": {
            "type": "string"
          },
          "serial_to": {
            "type": "string"
          },
          "vin_from": {
            "type": "string"
          },
          "vin_to": {
            "type": "string"
          },
          "fitment_notes": {
            "type": "string"
          }
        }
      }
    },
    "unit_of_measure": {
      "type": "string",
      "default": "each"
    },
    "pack_size": {
      "type": "string",
      "description": "e.g. 5L, 20L, Box of 50"
    },
    "volume_size": {
      "type": "string",
      "description": "Volume or size for oils/chemicals/sprays"
    },
    "barcode": {
      "type": "string"
    },
    "weight_kg": {
      "type": "number"
    },
    "dimensions": {
      "type": "string"
    },
    "hazardous": {
      "type": "boolean",
      "default": false
    },
    "dangerous_goods": {
      "type": "boolean",
      "default": false
    },
    "sds_required": {
      "type": "boolean",
      "default": false
    },
    "storage_notes": {
      "type": "string",
      "description": "Storage requirement notes for hazmat items"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiry date for oils, chemicals, compliance items"
    },
    "batch_lot_number": {
      "type": "string"
    },
    "compliance_type": {
      "type": "string",
      "description": "For compliance category items"
    },
    "compliance_reference": {
      "type": "string",
      "description": "Tag or certification reference"
    },
    "inspection_interval_days": {
      "type": "number",
      "description": "Inspection interval in days for compliance items"
    },
    "regulated_item": {
      "type": "boolean",
      "default": false
    },
    "workshop_use": {
      "type": "boolean",
      "default": false
    },
    "issue_method": {
      "type": "string",
      "enum": [
        "each",
        "pack",
        "carton",
        "weight",
        "volume"
      ],
      "default": "each"
    },
    "freight_class": {
      "type": "string"
    },
    "preferred_supplier": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "landed_cost": {
      "type": "number",
      "default": 0
    },
    "sell_price": {
      "type": "number",
      "default": 0
    },
    "trade_price": {
      "type": "number",
      "default": 0
    },
    "fleet_price": {
      "type": "number",
      "default": 0
    },
    "retail_price": {
      "type": "number",
      "default": 0
    },
    "margin_target": {
      "type": "number",
      "default": 30
    },
    "stock_quantity": {
      "type": "number",
      "default": 0
    },
    "allocated_stock": {
      "type": "number",
      "default": 0
    },
    "min_stock_level": {
      "type": "number",
      "default": 0
    },
    "max_stock_level": {
      "type": "number",
      "default": 0
    },
    "reorder_qty": {
      "type": "number",
      "default": 0
    },
    "location": {
      "type": "string"
    },
    "bin": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discontinued",
        "on_order",
        "inactive"
      ],
      "default": "active"
    },
    "is_critical": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "part_number",
    "name"
  ]
}