{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "COD",
        "Net_7",
        "Net_14",
        "Net_30"
      ],
      "default": "Net_30"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "type": {
      "type": "string",
      "enum": [
        "mine_site",
        "workshop",
        "fleet",
        "retail",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}