{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "trading_name": {
      "type": "string"
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "individual",
        "sole_trader",
        "trust",
        "partnership",
        "company",
        "other"
      ],
      "default": "company"
    },
    "customer_type_other": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "fax": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "physical_address_1": {
      "type": "string"
    },
    "physical_address_2": {
      "type": "string"
    },
    "physical_state": {
      "type": "string"
    },
    "physical_postcode": {
      "type": "string"
    },
    "billing_address_1": {
      "type": "string"
    },
    "billing_address_2": {
      "type": "string"
    },
    "billing_state": {
      "type": "string"
    },
    "billing_postcode": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "abn": {
      "type": "string"
    },
    "acn": {
      "type": "string"
    },
    "date_established": {
      "type": "string"
    },
    "nature_of_business": {
      "type": "string"
    },
    "paid_up_capital": {
      "type": "string"
    },
    "estimated_monthly_purchases": {
      "type": "string"
    },
    "credit_limit_required": {
      "type": "string"
    },
    "premises_type": {
      "type": "string",
      "enum": [
        "owned",
        "rented",
        "mortgaged",
        "other"
      ]
    },
    "premises_type_other": {
      "type": "string"
    },
    "directors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string"
          },
          "dob": {
            "type": "string"
          },
          "address_1": {
            "type": "string"
          },
          "address_2": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "licence_number": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          }
        }
      }
    },
    "account_terms": {
      "type": "string",
      "enum": [
        "30_days",
        "cod",
        "other"
      ],
      "default": "30_days"
    },
    "account_terms_other": {
      "type": "string"
    },
    "po_required": {
      "type": "boolean",
      "default": false
    },
    "accounts_emailed": {
      "type": "boolean",
      "default": false
    },
    "accounts_email": {
      "type": "string"
    },
    "accounts_contact_name": {
      "type": "string"
    },
    "accounts_contact_phone": {
      "type": "string"
    },
    "bank_branch": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "trade_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "contact": {
            "type": "string"
          }
        }
      }
    },
    "account_status": {
      "type": "string",
      "enum": [
        "cash_sale",
        "credit_pending",
        "under_review",
        "active_credit",
        "on_hold",
        "declined"
      ],
      "default": "cash_sale"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "COD",
        "due_on_receipt",
        "7_days",
        "14_days",
        "21_days",
        "30_days",
        "Net_30",
        "30_days_eom",
        "custom"
      ],
      "default": "30_days_eom"
    },
    "pricing_tier": {
      "type": "string",
      "enum": [
        "retail",
        "trade",
        "fleet",
        "workshop",
        "contract",
        "custom"
      ],
      "default": "trade"
    },
    "account_manager": {
      "type": "string"
    },
    "service_region": {
      "type": "string",
      "enum": [
        "karratha",
        "pilbara",
        "regional_wa",
        "statewide",
        "other"
      ]
    },
    "internal_notes": {
      "type": "string"
    },
    "credit_risk_notes": {
      "type": "string"
    },
    "special_pricing_notes": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "customer_tags": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "type": {
      "type": "string",
      "enum": [
        "mine_site",
        "workshop",
        "fleet",
        "retail",
        "other"
      ],
      "default": "other"
    },
    "notes": {
      "type": "string"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "created_by_method": {
      "type": "string"
    },
    "pdf_attachment_url": {
      "type": "string"
    },
    "external_risk_flag": {
      "type": "boolean",
      "default": false
    },
    "external_risk_level": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ],
      "default": "none"
    },
    "external_findings_summary": {
      "type": "string"
    },
    "external_confidence_level": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "external_assessment_date": {
      "type": "string",
      "format": "date-time"
    },
    "external_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "asic_regulatory",
              "legal_record",
              "news_article",
              "public_listing",
              "other"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "date": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sales_representative"
          }
        },
        {
          "user_condition": {
            "role": "accounts_manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.account_manager": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.account_manager": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}