{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "movement_number": {
      "type": "string"
    },
    "movement_date": {
      "type": "string"
    },
    "part_id": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "part_description": {
      "type": "string"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "goods_receipt",
        "stock_adjustment",
        "stocktake_posting",
        "transfer_out",
        "transfer_in",
        "sales_allocation",
        "dispatch",
        "return_in",
        "return_out",
        "warranty_hold",
        "quarantine_move",
        "writeoff",
        "opening_balance"
      ]
    },
    "qty_in": {
      "type": "number",
      "default": 0
    },
    "qty_out": {
      "type": "number",
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "default": 0
    },
    "value_impact": {
      "type": "number",
      "default": 0
    },
    "from_warehouse": {
      "type": "string"
    },
    "from_bin": {
      "type": "string"
    },
    "to_warehouse": {
      "type": "string"
    },
    "to_bin": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "performed_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "part_number",
    "movement_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "inventory_controller"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_operator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "inventory_controller"
          }
        },
        {
          "user_condition": {
            "role": "warehouse_operator"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}