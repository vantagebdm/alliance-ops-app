{
  "name": "BDMDeliverable",
  "type": "object",
  "properties": {
    "section_number": {
      "type": "number",
      "description": "Section number 1-19"
    },
    "section_title": {
      "type": "string"
    },
    "task_text": {
      "type": "string",
      "description": "The deliverable/task description (editable)"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "awaiting_approval",
        "approved",
        "done"
      ],
      "default": "not_started"
    },
    "owner": {
      "type": "string",
      "description": "Assigned task owner"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "quoted_price": {
      "type": "number",
      "default": 0
    },
    "approved_price": {
      "type": "number",
      "default": 0
    },
    "final_cost": {
      "type": "number",
      "default": 0
    },
    "supplier": {
      "type": "string"
    },
    "purchase_link": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "author_id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "has_unread_comments": {
      "type": "boolean",
      "default": false,
      "description": "Bell flag \u2014 new comment awaiting review"
    },
    "has_unread_edits": {
      "type": "boolean",
      "default": false,
      "description": "Bell flag \u2014 task was edited since last viewed"
    },
    "last_edited_by": {
      "type": "string"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "marked_critical": {
      "type": "boolean",
      "default": false,
      "description": "True when this task has been shifted to the Tasks Marked Critical portal"
    },
    "critical_viewed": {
      "type": "boolean",
      "default": true,
      "description": "False when moved to critical and not yet viewed in the Tasks Marked Critical portal \u2014 drives the hazard notification badge"
    },
    "critical_marked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "section_number",
    "section_title",
    "task_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}